;; wide-angle-mod:
;; - the ISO key (a.k.a. LSGT or 102 key) becomes Z
;; - the right hand is moved one key to the right

(defsrc
  `    1    2    3    4    5  bspc   6    7    8    9    0    -    =
       q    w    e    r    t         y    u    i    o    p    [    ]
       a    s    d    f    g         h    j    k    l    ;    '    \
       <    z    x    c    v    b    n    m    ,    .    /    rsft
  lsft           lalt          spc        ralt           rsft
)

;; vim: set ft=lisp
